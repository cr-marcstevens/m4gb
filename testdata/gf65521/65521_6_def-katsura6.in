$fieldsize 65521
$vars 6 x

x0 + 2*x1 + 2*x2 + 2*x3 + 2*x4 + 2*x5 - 1
x0^2 + 2*x1^2 + 2*x2^2 + 2*x3^2 + 2*x4^2 + 2*x5^2 - x0
2*x0*x1 + 2*x1*x2 + 2*x2*x3 + 2*x3*x4 + 2*x4*x5 - x1
x1^2 + 2*x0*x2 + 2*x1*x3 + 2*x2*x4 + 2*x3*x5 - x2
2*x1*x2 + 2*x0*x3 + 2*x1*x4 + 2*x2*x5 - x3
x2^2 + 2*x1*x3 + 2*x0*x4 + 2*x1*x5 - x4
